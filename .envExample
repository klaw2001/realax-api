PORT=4000

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/realax_dev?schema=public"

CORS_ORIGIN="http://localhost:3005"
API_BASEURL="http://localhost:4000"

# Signs the session cookie (build plan 0.3). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-at-least-32-characters-long-000000"

# Storage (build plan 0.4). Bucket is ca-central-1 with SSE-KMS, versioning
# and Object Lock on. AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are read by
# the SDK default chain; in production they come from the instance role.
AWS_REGION="ca-central-1"
AWS_S3_BUCKET="realax-documents-dev"
AWS_KMS_KEY_ID="arn:aws:kms:ca-central-1:000000000000:key/change-me"

# Cache (build plan 0.5). Local Redis in development:
#   brew services start redis
REDIS_URL="redis://localhost:6379"

# MLS (build plan 1.3). Billed per request — every call is cached in Redis for
# 24h. Server-side only; this key never reaches the frontend bundle.
#
# NOTE: the current key returns US board data (Austin, Charlotte, Nashville),
# not TRREB. See test/fixtures/repliers/README.md.
REPLIERS_API_KEY="change-me"
REPLIERS_BASE_URL="https://api.repliers.io"

# OCR for identity documents (build plan 2.5). Textract AnalyzeID, in the same
# region as the bucket — identity documents are FINTRAC material and do not
# leave ca-central-1, including to be read. AnalyzeID is available there;
# confirmed before the integration was written.
OCR_PROVIDER="textract"
OCR_REGION="ca-central-1"

# Field encryption for IdentityRecord.documentNumber, which the data model has
# always described as encrypted at rest. 32 bytes, hex or base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Rotating this makes every stored document number unreadable. Not a secret that
# can be regenerated casually.
IDENTITY_ENCRYPTION_KEY="change-me-32-bytes-base64-or-hex-0000000000="

# --- Identity document OCR ---------------------------------------------------
# textract = production (AWS, ca-central-1, Paid-plan AWS account required).
# azure    = free development reader; reads real cards. No key needed below?
#            then it will refuse to boot.
# mock     = fixtures. No network, no key, verifies nobody. This is what makes
#            the identity flow demonstrable offline while the AWS account is on
#            the Free plan and every Textract call is refused.
# barcode  = the PDF417 on the BACK of a driver's licence. Not OCR: the fields
#            are text the issuing authority encoded, so nothing can be misread.
#            Free, offline, and the document never leaves the process. Needs the
#            back of the card — a photo of the front yields nothing — and cannot
#            read a passport at all.
# Everything except textract is refused when NODE_ENV=production.
OCR_PROVIDER=textract

# Only when OCR_PROVIDER=azure. Create an Azure AI Document Intelligence
# resource on the F0 (free) tier in Canada Central, then copy both values from
# its "Keys and Endpoint" blade.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# --- Demo mode -------------------------------------------------------------
# Off unless this says "true". Turns on the demo-only button that marks a
# party's identity verified with no document and no examination — see UX plan
# item 02. Every record it writes carries verifiedMethod=demo_override and is
# labelled as such wherever a verification is shown, forever.
#
# The API refuses to start with this on when NODE_ENV=production. The frontend
# has its own NEXT_PUBLIC_DEMO_MODE, which only hides the button; this one is
# what decides whether the endpoint exists at all.
DEMO_MODE=false

# --- signNow (e-sign, phase 3) ----------------------------------------------
# mock = no network, no key, no invite quota, no email. Returns a deterministic
#        document id and runs the real HMAC, so the signing flow is testable and
#        demonstrable without an API plan.
# signnow = the real vendor.
#
# Defaulted to mock, unlike OCR_PROVIDER: signNow API access is a separate
# annual commitment and the trial lapses, so a fresh checkout must boot without
# a key. The API refuses to start with anything but signnow when
# NODE_ENV=production.
SIGNNOW_PROVIDER=mock
SIGNNOW_BASE_URL=https://api.signnow.com

# Both required when SIGNNOW_PROVIDER=signnow.
#
# A non-expiring bearer token from API Dashboard > Apps and Keys > your app >
# API Keys. NOT an OAuth client secret: client_credentials is not a grant
# signNow supports, and the password grant would put the account's own login
# password in this file. An API key does not expire, so there is no refresh
# logic, and it is revoked by deleting it in the dashboard.
SIGNNOW_API_KEY=

# The secret signNow signs each webhook body with. You choose the value —
# signNow does not issue it. Any string up to 300 characters; generate with:
#   openssl rand -hex 32
#
# It must ALSO be set on every subscription, which the dashboard does not do for
# you. Use tools/signnow_subscriptions.ts:
#   npx ts-node -r dotenv/config tools/signnow_subscriptions.ts sync <url> --prune
#
# Without it signNow sends no X-SignNow-Signature header, and /webhooks/signnow
# — which sits outside the session guard because signNow has no session — has
# nothing to authenticate with.
SIGNNOW_WEBHOOK_SECRET=

# Capture tooling only (tools/capture_signnow.ts). Never read by the service.
SIGNNOW_CAPTURE_SIGNER_1=
SIGNNOW_CAPTURE_SIGNER_2=

# Seed tooling only (prisma/seed.ts). Never read by the service.
#
# The seeded clients' addresses. They default to @example.test, which is the
# honest thing to give invented people — but signNow validates a recipient
# before creating an invite and refuses that TLD, so sending the demo
# transaction for signature against the live vendor needs real mailboxes.
# Gmail plus-addressing works: both signers land in one inbox.
SEED_SELLER_EMAIL=
SEED_BUYER_EMAIL=
