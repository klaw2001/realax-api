{
  "name": "realax-api",
  "version": "1.0.0",
  "description": "REALAX API — transaction automation for Ontario realtors",
  "main": "./dist/index.js",
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register -r dotenv/config prisma/seed.ts"
  },
  "scripts": {
    "dev": "kill-port 4000 && nodemon -r tsconfig-paths/register -r dotenv/config ./src/index.ts",
    "build": "tsc",
    "start": "node -r module-alias/register -r dotenv/config ./dist/index.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "jest ./test --verbose --setupFiles dotenv/config --detectOpenHandles",
    "gen:openapi": "ts-node -r tsconfig-paths/register -r dotenv/config src/openapi/generate.ts",
    "lint:fix": "eslint src test --fix",
    "db:seed": "prisma db seed",
    "db:migrate": "prisma migrate dev"
  },
  "author": "Rv - rv.prodeveloper@gmail.com",
  "license": "ISC",
  "_moduleAliases": {
    "@": "dist",
    "@core": "dist/@core"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express-session": "^1.19.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^17.11.0",
    "kill-port": "^2.0.1",
    "nodemon": "^3.1.9",
    "prettier": "3.5.3",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "@prisma/client": "^6.5.0",
    "@quixo3/prisma-session-store": "^3.1.21",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/express-fileupload": "^1.5.1",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/knex": "^0.16.1",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.2",
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-fileupload": "^1.5.1",
    "express-session": "^1.19.0",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "module-alias": "^2.2.3",
    "moment": "^2.30.1",
    "mysql": "^2.18.1",
    "nodemailer": "^6.10.0",
    "prisma": "^6.5.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2",
    "winston": "^3.17.0",
    "zod": "^4.5.4"
  }
}
