  "sourceSha256": "9ff3c8b27553c943f00c166b4ec8131226067500c43222d822933df6c681dc36",
  "note": "Curation for Form 801. One entry per blank id emitted by tools/extract_template.py. `name` is the key the field mapper emits and the fill engine draws. `kind` splits pre-send fields the compliance gate validates from fields supplied inside the signing session. `optional` marks a blank the gate does not require — see the sections below for why each one carries it.",
  "kinds": {
    "data": "Filled before signing. The compliance gate checks these unless they are marked optional.",
    "signature": "Drawn by a signer in the e-sign session. Never filled by us.",
    "signingDate": "Dated by the signer at execution, not by the agent."
  },
  "sections": {
    "submitting": "Page top, 'Section For Brokerage submitting the offer on behalf of the Buyer'. This is our side on a purchase, so it is required and mostly answered by the domain model.",
    "counterOffer": "'For Buyer counter offer - complete the following'. Optional throughout: most offers are not countered, and a form that demanded these could never be filled for one that was not.",
    "listingBrokerage": "'For Listing Brokerage receiving the offer'. The received and presented times are optional because they are facts the other side records after delivery — a co-operating agent filling this in has neither. The brokerage's own name and salesperson are not optional: we know who we are sending it to."
  },
