// REALAX — data model (build plan 0.2)
//
// Postgres via Prisma (Neon in prod, local Postgres in dev). The demo's
// single `Transaction` with a `Json` blob is retired here — the field
// shapes are known now.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Agents and brokerages
// ---------------------------------------------------------------------------

model Agent {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  // bcrypt digest. Nullable because the column is added to a table that
  // already holds seeded rows, and because an agent created by an import
  // legitimately has no password until one is set — such an agent simply
  // cannot log in. Never selected into an API response.
  passwordHash String?
  recoNumber   String?
  phone        String?
  brokerageId  String?
  brokerage    Brokerage?    @relation(fields: [brokerageId], references: [id])
  transactions Transaction[]
  createdAt    DateTime      @default(now())
}

// Server-side session records for `express-session` via
// `@quixo3/prisma-session-store`. The cookie carries only a signed session id;
// the agent id never leaves the server. Phase 0.5 may move this store to Redis
// — that is a one-line change in `src/app.ts`, and this table is the fallback
// until it happens.
model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model Brokerage {
  id      String  @id @default(cuid())
  name    String
  address String
  phone   String?
  agents  Agent[]
  // Seeded preset table — Phase 1 profile autofill
}

// ---------------------------------------------------------------------------
// Parties and identity
// ---------------------------------------------------------------------------

// A person on a transaction (build plan 1.5).
//
// The columns below the contact block are the ones an Ontario driver's licence
// yields and an OREA form or FINTRAC check actually consumes. They are filled by
// hand today; Phase 2.5 populates the same columns from an OCR'd scan, which is
// why they live here rather than waiting for the vendor decision. Nothing on the
// card that no form and no check asks for — sex, height, licence class — is
// stored: see NEEDS-KLAW for that list.
//
// The licence number and its expiry are deliberately NOT here. Those are
// `IdentityRecord`: FINTRAC material, encrypted at rest, five-year retention,
// and written only by the verification flow.
model Party {
  id              String             @id @default(cuid())
  fullLegalName   String
  email           String?
  phone           String?
  // The address as it appears on the licence, and the starting point for the
  // "address for service" blanks on the OREA forms. Editable — the two are
  // often not the same address.
  address         String?
  city            String?
  province        String?
  postalCode      String?
  // A calendar date, not an instant: `@db.Date` so a birth date read back in
  // another timezone is still the date printed on the card.
  dateOfBirth     DateTime?          @db.Date
  identityRecords IdentityRecord[]
  identityScans   IdentityScan[]
  roles           TransactionParty[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model IdentityRecord {
  id             String    @id @default(cuid())
  partyId        String
  party          Party     @relation(fields: [partyId], references: [id])
  documentType   String // drivers_licence | passport | …
  documentNumber String // encrypted at rest
  expiryDate     DateTime?
  verifiedAt     DateTime
  verifiedMethod String // FINTRAC method used
  s3Key          String
  // Retained 5 years. Object Lock applies to the S3 object.
  createdAt      DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Property
// ---------------------------------------------------------------------------

model Property {
  id               String        @id @default(cuid())
  mlsNumber        String?
  address          String
  city             String
  province         String        @default("ON")
  postalCode       String?
  frontingSide     String?
  frontingStreet   String?
  frontage         String?
  depth            String?
  legalDescription String?
  listPrice        Int?
  taxes            String?
  transactions     Transaction[]
}

// ---------------------------------------------------------------------------
// Transaction
// ---------------------------------------------------------------------------

enum TransactionType {
  LISTING
  PURCHASE
  LEASE
}

enum TransactionStatus {
  DRAFT
  COMPLIANCE_PENDING
  READY_TO_SIGN
  OUT_FOR_SIGNATURE
  COMPLETED
  CANCELLED
}

model Transaction {
  id         String              @id @default(cuid())
  type       TransactionType
  status     TransactionStatus   @default(DRAFT)
  agentId    String
  agent      Agent               @relation(fields: [agentId], references: [id])
  propertyId String?
  property   Property?           @relation(fields: [propertyId], references: [id])
  parties    TransactionParty[]
  entries    TransactionEntries?
  forms      TransactionForm[]
  envelopes  SigningEnvelope[]
  documents  Document[]
  identityScans IdentityScan[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

enum PartyRole {
  BUYER
  SELLER
  SPOUSE
  WITNESS
}

// One person in one role on one transaction. This is the row the parties API
// addresses: `Party` is the person, `TransactionParty` is their place in a deal.
model TransactionParty {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  partyId       String
  party         Party       @relation(fields: [partyId], references: [id])
  role          PartyRole
  signingOrder  Int?
  // Soft delete, and only ever on this row — never on `Party`. Removing a
  // seller from a listing must not disturb the same person on another
  // transaction, and their identity records are held five years regardless.
  // Every read filters on this being null.
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())

  @@unique([transactionId, partyId, role])
}

// ---------------------------------------------------------------------------
// Forms and compliance
// ---------------------------------------------------------------------------

model FormTemplate {
  id           String            @id @default(cuid())
  formCode     String // "100", "200a"
  revision     String // "May 2026"
  sourceSha256 String
  sourceS3Key  String
  fieldMap     Json // output of extract_template.py, curated
  forms        TransactionForm[]

  @@unique([formCode, revision])
}

enum FormStatus {
  DRAFT
  FILLED
  SIGNED
}

model TransactionForm {
  id             String            @id @default(cuid())
  transactionId  String
  transaction    Transaction       @relation(fields: [transactionId], references: [id])
  formTemplateId String
  formTemplate   FormTemplate      @relation(fields: [formTemplateId], references: [id])
  values         Json // merged object fed to the fill engine
  filledS3Key    String?
  status         FormStatus        @default(DRAFT)
  checks         ComplianceCheck[]
}

model ComplianceCheck {
  id                String          @id @default(cuid())
  transactionFormId String
  transactionForm   TransactionForm @relation(fields: [transactionFormId], references: [id])
  missingFields     Json
  overrides         Json // [{ field, reason, agentId, at }]
  passed            Boolean
  checkedAt         DateTime        @default(now())
}

// ---------------------------------------------------------------------------
// Signing
// ---------------------------------------------------------------------------

model SigningEnvelope {
  id             String        @id @default(cuid())
  transactionId  String
  transaction    Transaction   @relation(fields: [transactionId], references: [id])
  provider       String        @default("signnow")
  externalId     String        @unique
  status         String
  auditCertS3Key String?
  events         SignerEvent[]
  createdAt      DateTime      @default(now())
}

model SignerEvent {
  id         String          @id @default(cuid())
  envelopeId String
  envelope   SigningEnvelope @relation(fields: [envelopeId], references: [id])
  eventType  String
  payload    Json
  receivedAt DateTime        @default(now())
}

// ---------------------------------------------------------------------------
// Documents and audit
// ---------------------------------------------------------------------------

model Document {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  kind          String // id_scan | filled_form | signed_form | audit_cert
  s3Key         String
  sha256        String
  createdAt     DateTime    @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Form entries
// ---------------------------------------------------------------------------

// The agreement terms the domain model has no other column for (build plan 2.3).
//
// Form 100 names 76 data blanks. Twenty-four of them the domain model already
// answers — the parties' names, the property, the agent's brokerage — and the
// mapper fills those from `Property`, `TransactionParty` and `Agent`. The other
// fifty-two are the deal itself: the price, the deposit, the dates, the
// chattels, the lawyers. Those are this table.
//
// Every column below exists because `mapper.service.ts` reads the entry key it
// carries. Nothing here is a field the mapper would ignore, and the fifty-two
// blanks are covered exactly once: `agreementDate` alone fans out into three of
// them, and Schedule A's date follows the agreement's rather than having a
// column of its own — one agreement, one date.
//
// A `Json` blob would have done the same job and is what the demo used. It is
// not what this is, for the reason the top of this file gives: the field shapes
// are known now, and a typed column is what makes a missing completion date a
// compliance failure rather than a key nobody noticed was misspelled.
model TransactionEntries {
  id            String      @id @default(cuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  // --- The agreement ------------------------------------------------------
  // Calendar dates, not instants: `@db.Date`, so a completion date read back in
  // another timezone is still the date printed on the agreement. The mapper
  // splits each one into the day / month / year the forms print separately.
  agreementDate DateTime? @db.Date

  // Decimal rather than a float. This figure is drawn onto a contract, and
  // binary floating point is not a thing to write a purchase price in.
  purchasePrice      Decimal? @db.Decimal(12, 2)
  // The same figure spelled out — the form prints both, and the words govern.
  purchasePriceWords String?

  // "Buyer submits herewith" / "upon acceptance" — a phrase, not a date.
  depositTiming      String?
  depositAmount      Decimal? @db.Decimal(12, 2)
  depositAmountWords String?
  // The brokerage holding the deposit in trust.
  depositHolder      String?

  // "A" — which schedules form part of the agreement.
  schedulesList String?

  // Which side is bound, until when, on what date.
  irrevocabilityBoundParty String?
  irrevocabilityTime       String?
  irrevocabilityDate       DateTime? @db.Date

  completionDate  DateTime? @db.Date
  titleSearchDate DateTime? @db.Date

  // --- Notices ------------------------------------------------------------
  // Fax only. The email blanks are the parties' own and come from `Party`.
  noticesSellerFax String?
  noticesBuyerFax  String?

  // --- The ruled blocks ---------------------------------------------------
  // Lists, one item per element, because that is what an agent is writing down.
  // They are joined and flowed across the form's ruled continuation lines at
  // fill time, where the font metrics are — see `flow` in the curated template.
  chattelsIncluded String[]
  fixturesExcluded String[]
  rentalItems      String[]

  // "included in" / "in addition to" the purchase price.
  hstTreatment String?

  // The present use the agreement warrants — "single family residential".
  propertyPresentUse String?

  // --- The other side's brokerage ------------------------------------------
  // On a listing the agent's own brokerage is the listing brokerage and comes
  // from their profile; the co-operating brokerage acts for the buyer and is
  // typed in. There is no listing-brokerage column here for the same reason:
  // only LISTING is wired (build plan 1.2), so the profile always answers it.
  coopBrokerageName        String?
  coopBrokerageTel         String?
  coopBrokerageSalesperson String?

  // --- Lawyers -------------------------------------------------------------
  sellerLawyerName    String?
  sellerLawyerAddress String?
  sellerLawyerEmail   String?
  sellerLawyerTel     String?
  sellerLawyerFax     String?

  buyerLawyerName    String?
  buyerLawyerAddress String?
  buyerLawyerEmail   String?
  buyerLawyerTel     String?
  buyerLawyerFax     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A document that has been stored and read, but that no agent has confirmed
/// yet (build plan 2.5).
///
/// The reading is not the record. Textract's AnalyzeID is trained on US
/// documents and an Ontario licence is not a document it is verified against,
/// so every field it returns is a proposal. This row is where a proposal waits
/// while the agent checks it against the card in their hand; confirming turns
/// it into an `IdentityRecord`, and a scan nobody confirms simply stays here
/// unconfirmed rather than becoming a verification that never happened.
///
/// It holds the encrypted document number between the two requests. That is the
/// reason this is a table and not a Redis key: `lib/redis.ts` is a cache whose
/// contents must always be reproducible from Postgres, and re-reading a licence
/// to reproduce a value is a second billed Textract call. Keeping it here also
/// means an unconfirmed scan is answerable to an examiner — the object exists in
/// the bucket either way, and this says why.
model IdentityScan {
  id             String      @id @default(cuid())
  transactionId  String
  transaction    Transaction @relation(fields: [transactionId], references: [id])
  /// The person, not the party-on-a-transaction row — same key as IdentityRecord.
  partyId        String
  party          Party       @relation(fields: [partyId], references: [id])
  /// What the agent declared at upload. The confirmed type lives on the record.
  documentType   String
  /// Encrypted at rest, exactly as on IdentityRecord. "" when none was read.
  documentNumber String
  expiryDate     DateTime?
  s3Key          String
  /// Of the uploaded bytes, so confirming can write the Document row without
  /// fetching the object back out of S3.
  sha256         String
  confidence     Float
  confirmedAt    DateTime?
  /// The IdentityRecord this became, once it became one.
  recordId       String?
  createdAt      DateTime    @default(now())

  @@index([transactionId, partyId])
}
